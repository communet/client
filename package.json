{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "check:format:fix": "prettier --write \"src/**/*.{ts,tsx}\"",
    "check:lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check:lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "check:types": "tsc --noEmit",
    "check:architecture": "steiger ./src",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/core": "^8.3.4",
    "@mantine/hooks": "^8.3.4",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.129.8",
    "@tanstack/react-router-devtools": "^1.129.8",
    "axios": "^1.12.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@tanstack/router-plugin": "^1.129.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "sass": "^1.93.2",
    "steiger": "^0.5.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
